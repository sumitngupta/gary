# Copy to .env and fill in. Only the three uncommented lines are required.
# Every other line shows the default or an example value; uncomment to change it.

# --- Required ---------------------------------------------------------------

# Key for the model provider. OPENAI_API_KEY is accepted as a fallback.
LLM_API_KEY=
# Seerr receives every media request Gary makes.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=

# --- Model ------------------------------------------------------------------

# Provider/model id for Mastra's model router, or a bare model id when LLM_BASE_URL is set.
# LLM_MODEL=openai/gpt-5.6-luna
# Any OpenAI-compatible endpoint, e.g. http://ollama:11434/v1. Leave unset for OpenAI.
# LLM_BASE_URL=
# Speech-to-text model for voice notes. Defaults to gpt-4o-mini-transcribe on OpenAI; unset disables voice notes elsewhere.
# LLM_TRANSCRIBE_MODEL=
# Alternative name for LLM_API_KEY.
# OPENAI_API_KEY=

# --- Server -----------------------------------------------------------------

# Where Gary keeps its databases. The image sets this to /data.
# GARY_DATA_DIR=./data
# HTTP port inside the container.
# PORT=4111
# How Gary names your server and its admin in replies.
# GARY_SERVER_NAME=the media server
# GARY_ADMIN_NAME=the admin
# The https:// address people use for the web chat. Marks the session cookie Secure.
# GARY_PUBLIC_URL=https://gary.example.com
# Password that signs a browser in as the admin. Without it, use the GARY- code printed on first boot.
# GARY_ADMIN_PASSWORD=
# Bearer token for /api/* (Mastra Studio and the REST API) and the escalation routes. Unset keeps them closed.
# GARY_ADMIN_TOKEN=
# Set true only behind a reverse proxy, so sign-in rate limits use the client address from x-forwarded-for.
# GARY_TRUST_PROXY=false

# --- Safety -----------------------------------------------------------------

# Refuse every request, media-server change and outgoing message, and stop scheduled jobs. Use it for previews.
# GARY_READ_ONLY=false
# Set false to keep Gary answering questions but stop it filing new requests.
# GARY_ALLOW_REQUESTS=true
# Requests and other changes each member may make per day. Admins are exempt.
# GARY_DAILY_MUTATION_LIMIT=10
# Personal list edits each member may make per day.
# GARY_DAILY_LIST_LIMIT=100
# Web searches each person may trigger per hour.
# GARY_HOURLY_WEB_LIMIT=100
# Messages each person may send per hour before Gary asks them to slow down.
# GARY_HOURLY_INBOUND_LIMIT=120
# How long a "yes, request it" preview stays valid.
# GARY_CONFIRMATION_TTL_MINUTES=15
# Pause between requests in a batch, in milliseconds.
# GARY_BATCH_THROTTLE_MS=500

# --- Media services (each optional; set the URL and key together) ----------

# Sonarr and Radarr: series and movie status, diagnostics and fresh searches.
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# Plex: what is ready to watch, collections and list shelves.
# PLEX_URL=http://plex:32400
# PLEX_TOKEN=
# Tautulli: watch history for recommendations.
# TAUTULLI_URL=http://tautulli:8181
# TAUTULLI_API_KEY=
# Prowlarr and SABnzbd: download health when a request looks stuck.
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=
# SABNZBD_URL=http://sabnzbd:8080
# SABNZBD_API_KEY=
# Shared secret for Sonarr, Radarr and Plex webhooks (Bearer header or ?token=).
# GARY_MEDIA_EVENTS_TOKEN=
# Hours between repeat "this download looks stalled" alerts for one title.
# GARY_STALLED_ALERT_COOLDOWN_HOURS=6
# Radarr and Sonarr quality profile ids used when someone asks for the best 4K copy.
# GARY_HARD_QUALITY_RADARR_PROFILE_ID=
# GARY_HARD_QUALITY_SONARR_PROFILE_ID=
# JSON file with {"pct": <used percent>, "avail": "<free space>"} that a host job keeps current.
# GARY_STORAGE_HEALTH_FILE=
# Used-space percentages at which Gary warns, then pauses new requests (an unreadable file also pauses them).
# GARY_STORAGE_WARNING_PERCENT=85
# GARY_STORAGE_CRITICAL_PERCENT=92

# --- Chat channels (the web chat is always on) ----------------------------

# Telegram bot token from @BotFather. Gary long-polls, so no public URL is needed.
# TELEGRAM_BOT_TOKEN=
# WhatsApp Cloud API: set all four or none. See docs/channels.md.
# GARY_WHATSAPP_ACCESS_TOKEN=
# GARY_WHATSAPP_APP_SECRET=
# GARY_WHATSAPP_PHONE_NUMBER_ID=
# GARY_WHATSAPP_VERIFY_TOKEN=
# Graph API version for WhatsApp calls.
# GARY_WHATSAPP_GRAPH_VERSION=v25.0
# Approved message templates for "it's ready" notices sent outside WhatsApp's 24-hour window.
# GARY_WHATSAPP_MEDIA_AVAILABLE_TEMPLATE=gary_media_available
# GARY_WHATSAPP_MEDIA_BATCH_TEMPLATE=gary_tracked_titles_available

# --- Web lookup (optional) --------------------------------------------------

# Live web search and page fetch. Exa is tried first.
# EXA_API_KEY=
# Bright Data SERP and Web Unlocker, the fallback when Exa fails.
# BRIGHTDATA_API_TOKEN=
# BRIGHTDATA_SERP_ZONE=serp_api1
# BRIGHTDATA_WEB_UNLOCKER_ZONE=
